# Backend environment variables (copy to .env in production)
# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# App
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_secret
FRONTEND_URL=https://your-frontend.example.com

# Email (SMTP) - used for notifications/escalations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
EMAIL_FROM="AtomQuest <noreply@example.com>"

# Optional toggles
ENABLE_ESCALATIONS=trueDATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-strong-secret"
FRONTEND_URL="http://localhost:5173"
PORT=4000
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AtomQuest <no-reply@atomquest.demo>"
ESCALATION_DAYS_SUBMIT=7
ESCALATION_DAYS_APPROVAL=7
ENABLE_ESCALATIONS=true
OPENAI_API_KEY="replace-with-openai-key"
OPENAI_MODEL="gpt-4o-mini"